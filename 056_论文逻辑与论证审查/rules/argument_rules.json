  "note": "overlap = |claim_tokens ∩ premise_tokens| / |claim_tokens|；边只从『证据章节』指向『解释章节』，或同章节相邻句且重合度更高时成立；解释章节内部双向需更强重合以捕捉循环论证"
 },
 "issue_types": {
  "T1_UNSUPPORTED_CLAIM": {
   "label": "结论无支撑边",
   "category": "insufficient_evidence",
   "category_label": "证据不足",
   "facets": [
    "argument_chain"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "该结论在论证图中没有任何来自结果/方法章节的支撑边，属于结论跳跃（词面重合口径，见 uncertainty）",
   "fix_template": "为该句结论在结果章节补对应证据，或改写为不依赖数据的表述（局限/展望）；避免只删形容词"
  },
  "T2_ASSUMPTION_ONLY": {
   "label": "仅由假设支撑",
   "category": "insufficient_evidence",
   "category_label": "证据不足",
   "facets": [
    "argument_chain"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "结论的支撑边全部来自假设句，隐含假设未在主文中说明",
   "fix_template": "把该假设显式写进方法并说明若不成立结论如何变化"
  },
  "T3_CIRCULAR": {
   "label": "循环论证",
   "category": "insufficient_evidence",
   "category_label": "证据不足",
   "facets": [
    "argument_chain"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "支撑关系中存在环：A 支撑 B 且 B 支撑 A，论证自我确认",
   "fix_template": "删除环中一条推论，改为各自独立引用外部证据或本文结果"
  },
  "T4_PROMISE_UNDELIVERED": {
   "label": "引言承诺未交付",
   "category": "coherence_break",
   "category_label": "章节衔接断裂",
   "facets": [
    "section_coherence"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "引言声明的目标在结果/方法章节没有对应交付",
   "fix_template": "在结果章节补该目标的分析，或把引言目标改写为实际交付的范围"
  },
  "T5_STRENGTH_MISMATCH": {
   "label": "结论强度越界",
   "category": "overclaim",
   "category_label": "结论超数据",
   "facets": [
    "argument_chain"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "结果章节用 hedge（可能/相关/提示），该句用强断言（证明/确立/确凿），表述强度超出证据",
   "fix_template": "把该句强断言词降为与结果一致的表述（『与…相关』『提示』），或补更强证据（随机/纵向设计）"
  },
  "T6_CAUSAL_IN_CORRELATIONAL": {
   "label": "相关当因果",
   "category": "correlation_as_causation",
   "category_label": "相关当因果",
   "facets": [
    "argument_chain"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "观察性/横断面设计中该句使用因果动词或因果名词，因果方向依赖未声明的设计假设",
   "fix_template": "把该句改为关联表述（『与…相关』），或在方法中补因果识别设计（随机分配/纵向随访/工具变量）并重写该句"
  },
  "T7_NUM_CROSS_SECTION": {
   "label": "跨章节数值不一致",
   "category": "fact_error",
   "category_label": "事实错误",
   "facets": [
    "fact_check",
    "stats_reporting"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": true,
    "fixable": true
   },
   "why": "同一指标在多个章节取值不一致，结论依赖的数值来源不明",
   "fix_template": "统一该指标数值，并在每一处注明唯一来源（表号/图号/数据库版本）"
  },
  "T8_CONTRADICTORY_EDGE": {
   "label": "文中存在相反证据但结论未处理",
   "category": "internal_inconsistency",
   "category_label": "内部不一致",
   "facets": [
    "citation_support"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "图中存在攻击边（相反结果/相反文献）指向该结论，但该句未做限定或解释",
   "fix_template": "在该句正面处理相反证据（为何仍成立/适用边界），或把结论限定到证据范围内"
  },
  "T9_METHOD_ANSWER_GAP": {
   "label": "方法无法回答研究问题",
   "category": "method_answer_gap",
   "category_label": "方法无法回答问题",
   "facets": [
    "method_design"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "引言以因果/机制口径提出目标，而方法为观察性/横断面设计且无因果识别要素",
   "fix_template": "把该目标降为关联假设并同步修改结论口径，或补可回答该问题的设计（随机/纵向/准实验）"
  },
  "T10_STATS_REPORTING": {
   "label": "统计报告要素缺失",
   "category": "norm_issue",
   "category_label": "规范问题",
   "facets": [
    "stats_reporting",
    "academic_norm"
   ],
   "severity_answers": {
    "affects_main_conclusion": false,
    "affects_reproducibility": false,
    "fixable": true,
    "advisory": true
   },
   "why": "该句报了显著性但缺效应量/精确 p 值/检验方法，读者无法复核",
   "fix_template": "为该句补齐统计报告要素：效应量 + 95%CI + 检验统计量与精确 p 值（或声明非精确报告的原因）"
  },
  "T11_FIGTAB_MISSING": {
   "label": "图表引用与本体不对应",
   "category": "fact_error",
   "category_label": "事实错误",
   "facets": [
    "fact_check",
    "section_coherence",
    "academic_norm"
   ],
   "severity_answers": {
    "affects_main_conclusion": false,
    "affects_reproducibility": true,
    "fixable": true
   },
   "why": "正文引用了不存在/未呈现的图表编号（或已声明图表从未被正文引用）",
   "fix_template": "补上该编号的图/表本体，或删除/改正正文对该编号的引用"
  },
  "T12_SIGN_CONFLICT": {
   "label": "同暴露系数方向冲突",
   "category": "internal_inconsistency",
   "category_label": "内部不一致",
   "facets": [
    "fact_check",
    "stats_reporting"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": true,
    "fixable": true
   },
   "why": "同一暴露/结局语境下两处系数方向相反，可能口径不同或为有意对照，需核对",
   "fix_template": "核对两处系数口径（变量、模型、样本），统一或在文中说明方向差异的原因"
  },
  "T13_STRENGTH_DIRECTION_MISMATCH": {
   "label": "摘要与结论强度方向不一致",
   "category": "internal_inconsistency",
   "category_label": "内部不一致",
   "facets": [
    "section_coherence"
   ],
   "severity_answers": {
    "affects_main_conclusion": true,
    "affects_reproducibility": false,
    "fixable": true
   },
   "why": "摘要与结论对同一主结论的强度口径相反（一强一弱），读者无法判断实际证据强度",
   "fix_template": "把摘要与结论统一到与结果一致的强度口径（较强的一方降档）"
  },
  "T14_METHODS_RESULTS_TERMS": {
   "label": "方法声明的指标结果未报告",
   "category": "coherence_break",
   "category_label": "章节衔接断裂",
   "facets": [
    "section_coherence",
    "stats_reporting"
   ],
   "severity_answers": {
    "affects_main_conclusion": false,
    "affects_reproducibility": true,
    "fixable": true
   },
   "why": "方法声明使用某指标/信度检验，但结果章节从未报告对应数值",
   "fix_template": "在结果章节补报该指标数值，或从方法中删除未执行的声明"
  }
 },
 "false_positive_guards": {
  "rules": [
   {
    "id": "G_INTENDED_CONTROL",
    "when": "句子或所在章节含有意对照标记（negative control/对照组/安慰剂/as expected）",
    "action": "suppress",
    "applies_to": [
     "T6_CAUSAL_IN_CORRELATIONAL",
     "T12_SIGN_CONFLICT",
     "T5_STRENGTH_MISMATCH",
     "T7_NUM_CROSS_SECTION",
     "T1_UNSUPPORTED_CLAIM"
    ]
   },
   {
    "id": "G_EXPLICIT_ASSUMPTION",
    "when": "句为作者显式标注的假设情形（hypothesize/assume/假设/推测）",
    "action": "suppress",
    "applies_to": [
     "T6_CAUSAL_IN_CORRELATIONAL",
     "T5_STRENGTH_MISMATCH",
     "T1_UNSUPPORTED_CLAIM",
     "T7_NUM_CROSS_SECTION",
     "T12_SIGN_CONFLICT"
    ]
   },
   {
    "id": "G_REPORTED_VIEW",
    "when": "句为转述他人观点（et al/既往研究/reported that/文献报道）",
    "action": "suppress",
    "applies_to": [
     "T6_CAUSAL_IN_CORRELATIONAL",
     "T5_STRENGTH_MISMATCH",
     "T1_UNSUPPORTED_CLAIM",
     "T7_NUM_CROSS_SECTION",
     "T12_SIGN_CONFLICT",
     "T9_METHOD_ANSWER_GAP"
    ]
   },
   {
    "id": "G_LIMITATION_SECTION",
    "when": "问题出现在 Limitations/局限/不足 段落",
    "action": "suppress",
    "applies_to": [
     "ALL"
    ]
   }
  ],
  "note": "命中即不进入 findings，写入 suppressed 列表（含 guard_id、命中原因、原文引用与句子定位），供评审核对『该报未报』质疑"
 }
}
