    "type": "require_fulltext",
    "label": "全文可得"
   }
  ],
  "reason_codes": {
   "FB_TYPE": "类型不在回退口径允许集合内",
   "FB_ABSTRACT": "缺摘要且正文不可得（回退口径）",
   "FB_FULLTEXT": "全文不可得（回退口径）"
