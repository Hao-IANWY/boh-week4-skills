 },
 "primary_reason_rule": {
  "strategy": "fixed_order_strictest_first",
  "order": [
   "C5_FULLTEXT",
   "C2_TYPE",
   "C1_YEAR",
   "C6_LANG",
   "C3_ABSTRACT",
   "C4_OBJECT",
   "C7_OUTCOME"
  ],
  "note": "同一记录同一阶段命中多条排除条款时，主因取本表最先命中者；其余命中记入 secondary_hits，不重复计数，保证每条排除记录只落一个原因桶。案例协议可用 primary_reason_order 覆盖。"
 },
 "screening_policy": "两轮筛选（题录级 → 全文级）使用同一套条款表；每条记录评估该阶段全部条款并记 criterion_hits；排除只取规则定义的唯一主因；元数据缺失导致不可判定的条款转人工复核队列，不自动排除；不得在筛选途中放宽或新增条款；重复文献只在识别阶段删除。",
 "manual_review_policy": "undecidable 条款（年份/类型/语言缺失、正文为空、条款类型未知等）不自动排除：记录继续走完流程并标记 needs_manual_review，进入 screening_log.manual_review 队列。自动筛选止步于此，人工复核边界明示。",
 "fallback_screening": {
